{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sap.local/schemas/files/file_json_event.json",
  "title": "File Ingestion - JSON Content Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventType", "metadata", "file", "timestamp"],
  "properties": {
    "eventType": {
      "type": "string",
      "enum": ["FILE_INGESTED"]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceSystem",
        "fileName",
        "fileType",
        "structure",
        "contentVersion"
      ],
      "properties": {
        "sourceSystem": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "fileName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "fileType": {
          "type": "string",
          "enum": ["JSON"]
        },
        "structure": {
          "type": "string",
          "enum": ["OBJECT", "ARRAY", "JSONL"]
        },
        "contentVersion": {
          "type": "string",
          "pattern": "^v[0-9]+(\\.[0-9]+)*$"
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content"],
      "properties": {
        "content": {
          "oneOf": [
            {
              "type": "object"
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "oneOf": [
                  { "type": "object" },
                  { "type": "string" },
                  { "type": "number" },
                  { "type": "integer" },
                  { "type": "boolean" },
                  { "type": "null" }
                ]
              }
            }
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "metadata": {
            "properties": {
              "structure": {
                "const": "OBJECT"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "file": {
            "properties": {
              "content": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "metadata": {
            "properties": {
              "structure": {
                "enum": ["ARRAY", "JSONL"]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "file": {
            "properties": {
              "content": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      }
    }
  ]
}