{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sap.local/schemas/files/file_xml_event.json",
  "title": "File Ingestion - XML Content Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventType", "metadata", "file", "timestamp"],
  "properties": {
    "eventType": {
      "type": "string",
      "enum": ["FILE_INGESTED"]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceSystem",
        "fileName",
        "fileType",
        "structure",
        "contentVersion"
      ],
      "properties": {
        "sourceSystem": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "fileName": {
          "type": "string",
          "pattern": "^.*\\.xml$"
        },
        "fileType": {
          "type": "string",
          "enum": ["XML"]
        },
        "structure": {
          "type": "string",
          "enum": ["TREE", "DOCUMENT"]
        },
        "contentVersion": {
          "type": "string",
          "pattern": "^v[0-9]+(\\.[0-9]+)*$"
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rootTag", "records"],
      "properties": {
        "rootTag": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
        },
        "namespaces": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "format": "uri"
          }
        },
        "records": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "oneOf": [
                { "type": "string" },
                { "type": "number" },
                { "type": "integer" },
                { "type": "boolean" },
                { "type": "null" }
              ]
            }
          }
        }
      }
    }
  }
}