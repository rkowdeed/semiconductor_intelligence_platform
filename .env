# ---------------------------------------------------------------------------
# Semiconductor_Operations_Data_Platform - Environment Configuration
# ---------------------------------------------------------------------------

# Application
APP_NAME=Semiconductor_Operations_Data_Platform
APP_OWNER_EMAIL=ravikanth.kowdeed@gmail.com
APP_ENV=local
LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=semiconductor
POSTGRES_USER=sap_user
POSTGRES_PASSWORD=sap_password
DATABASE_URL=postgresql+psycopg2://sap_user:sap_password@postgres:5432/semiconductor

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@sap.local
PGADMIN_DEFAULT_PASSWORD=admin

# AWS (real account)
AWS_REGION=ap-south-2
AWS_PROFILE=agent-toolkit
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL=

# S3
S3_LANDING_BUCKET=semiconductor-landing

# Kinesis
KINESIS_MES_STREAM=mes-events
KINESIS_METADATA_STREAM=metadata-events
KINESIS_QUALITY_STREAM=quality-events

# Ingestion Service
INGESTION_SERVICE_PORT=8000

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
